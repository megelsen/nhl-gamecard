# Enables /refresh (forced full re-fetch, ~100 NHL API requests). Send it as a header:
#   curl -H "X-Refresh-Token: <token>" http://127.0.0.1:8000/refresh
# Empty = /refresh returns 404. Blocked at the Cloudflare edge, so call it on the host.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
REFRESH_TOKEN=

# true enables /debug-nhl (uncached NHL API proxy). Keep false on the public site.
DEBUG_ROUTES=false

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel > install
# command: the long string after --token). Required: compose refuses to start without it.
CF_TUNNEL_TOKEN=

# Zone the site lives under; the public hostname is hockey.${DOMAIN}.
DOMAIN=megelsen.com
