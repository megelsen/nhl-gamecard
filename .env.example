# Flask session key: keeps sessions (and the dynamic CSS) valid across restarts.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Enables /refresh (forced full re-fetch, ~100 NHL API requests). Send it as a header:
#   curl -H "X-Refresh-Token: <token>" http://127.0.0.1:8000/refresh
# Empty = /refresh returns 404. Generate like SECRET_KEY.
REFRESH_TOKEN=

# true enables /debug-nhl (uncached NHL API proxy). Keep false on the public site.
DEBUG_ROUTES=false
